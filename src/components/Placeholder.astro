---
import { site } from '../data/site';
interface Props {
  /** what the slot is for; no claim text */
  note: string;
}
---
<span class="ph t-mono">{site.placeholders.tag} · {Astro.props.note}</span>
<style>
  .ph { display: inline-block; margin-bottom: 22px; padding: 4px 10px; color: var(--amber); border: 1px dashed var(--amber); border-radius: var(--r-1); font-size: var(--fs-small); line-height: 1.3; letter-spacing: 0.06em; text-transform: uppercase; }
</style>
