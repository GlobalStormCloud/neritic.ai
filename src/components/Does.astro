---
import { cardLearn, cardDrift, cardDriftFlag, cardShapes } from '../data/signals';
import { site } from '../data/site';
const d = site.does;
const num = (n: number) => String(n).padStart(2, '0');
const learnLanes = [28, 70, 112];
const driftLanes = [30, 78, 126, 174, 222];
const shapeLanes = [16, 40, 64, 88];
---
<section class="sec" id="what">
  <div class="wrap">
    <div class="sec__head reveal"><span class="t-mono">01</span><h2 class="t-h2">{d.label}</h2></div>
    <div class="cards">
      <article class="card card--1 reveal">
        <div>
          <span class="n t-mono">{num(1)}</span>
          <p class="stmt t-statement">{d.items[0]}</p>
        </div>
        <div class="card__fig">
          <svg class="mini" viewBox="0 0 400 140" aria-hidden="true" focusable="false">
            {learnLanes.map((y, i) => <><line class="lane" x1="0" x2="400" y1={y} y2={y} /><path class="trace" d={cardLearn[i]} /></>)}
          </svg>
        </div>
      </article>
      <article class="card card--2 reveal" style="--d: 0.08s">
        <span class="n t-mono">{num(2)}</span>
        <p class="stmt t-statement">{d.items[1]}</p>
      </article>
      <article class="card card--3 reveal" style="--d: 0.16s">
        <span class="n t-mono">{num(3)}</span>
        <p class="stmt t-statement">{d.items[2]}</p>
        <div class="card__fig">
          <svg class="mini" viewBox="0 0 400 252" aria-hidden="true" focusable="false">
            {driftLanes.map((y) => <line class="lane" x1="0" x2="400" y1={y} y2={y} />)}
            {cardDrift.map((p) => <path class="trace" d={p} />)}
            <path class="trace trace--flag" d={cardDriftFlag} />
            <line class="mark" x1="230" x2="230" y1="8" y2="244" />
            <ellipse class="halo" cx="230" cy="174" rx="9" ry="6.6" />
            <ellipse class="lamp" cx="230" cy="174" rx="5" ry="3.7" />
          </svg>
        </div>
      </article>
      <article class="card card--4 reveal">
        <div>
          <span class="n t-mono">{num(4)}</span>
          <p class="stmt t-statement">{d.items[3]}</p>
        </div>
        <div class="card__fig">
          <svg class="mini" viewBox="0 0 400 104" aria-hidden="true" focusable="false">
            {shapeLanes.map((y, i) => <><line class="lane" x1="0" x2="400" y1={y} y2={y} /><path class="trace" d={cardShapes[i]} /></>)}
          </svg>
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .cards { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .card { position: relative; display: flex; flex-direction: column; gap: 20px; padding: clamp(22px, 2.6vw, 40px); background: var(--graphite); border: 1px solid var(--rule); border-radius: var(--r-2); }
  .n { color: var(--mist-lt); }
  .card--1 { grid-column: span 12; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 20px clamp(28px, 5vw, 80px); align-items: center; padding-block: clamp(28px, 4vw, 64px); }
  .card--1 .stmt { max-width: 17em; margin-top: 18px; font-size: clamp(1.625rem, 1.2rem + 1.7vw, 3rem); line-height: 1.12; font-weight: 600; font-stretch: 112%; letter-spacing: -0.012em; }
  .card--2 { grid-column: 1 / span 5; grid-row: 2; }
  .card--4 { grid-column: 1 / span 5; grid-row: 3; }
  .card--3 { grid-column: 6 / span 7; grid-row: 2 / span 2; border-color: rgba(245, 163, 0, 0.38); }
  .card--3 .n { color: var(--amber); }
  .card--3 .stmt { max-width: 15em; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.5rem); line-height: 1.15; }
  .card--3 .card__fig { padding-top: 12px; }
  .card--4 .stmt { margin-top: 20px; }
  .card__fig { margin-top: auto; }
  @media (prefers-reduced-motion: no-preference) { .card { transition: border-color 0.25s, background-color 0.25s; } }
  .card:hover { border-color: var(--rule-2); background: #1d2229; }
  @media (max-width: 900px) {
    .card--1 { grid-template-columns: minmax(0, 1fr); }
    .card--2, .card--3, .card--4 { grid-column: 1 / -1; grid-row: auto; }
  }
</style>
