---
import Button from './Button.astro';
import { contactBg } from '../data/signals';
import { DEMO_URL, site } from '../data/site';
const c = site.contact;
---
<section class="sec cta" id="contact">
  <div class="bg" aria-hidden="true">
    <svg viewBox="0 0 1000 200" preserveAspectRatio="none">
      {contactBg.map((d) => <path class="trace" d={d} />)}
    </svg>
  </div>
  <div class="wrap">
    <p class="t-legend reveal">{c.label}</p>
    <h2 class="t-h2 t-h2--xl reveal">{c.heading}</h2>
    <div class="row reveal">
      <Button href={DEMO_URL} size="lg">{c.demo}</Button>
      <div>
        <span class="hello t-mono">{c.hello}</span>
        <a class="mail t-email" href={`mailto:${c.email}`}>{c.email}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { overflow: hidden; isolation: isolate; background: var(--graphite); }
  .bg { position: absolute; left: 0; right: 0; bottom: 0; height: 60%; z-index: -1; opacity: 0.35; -webkit-mask-image: linear-gradient(transparent, #000); mask-image: linear-gradient(transparent, #000); }
  .bg svg { width: 100%; height: 100%; }
  .t-legend { margin-bottom: 22px; }
  h2 { max-width: 15em; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 40px; margin-top: clamp(28px, 3vw, 44px); }
  .hello { color: var(--mist-lt); }
  .mail { display: flex; align-items: center; width: fit-content; max-width: 100%; min-height: 44px; margin-top: 2px; text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 1px; text-underline-offset: 6px; overflow-wrap: anywhere; }
</style>
