---
import { site } from '../data/site';
const { tag, caption } = site.illustration;
---
<!-- The framed plate that holds a signal illustration: corner brackets, the "Illustration" tag and the caption. -->
<figure class="plate">
  <i></i><i></i><i></i><i></i>
  <div class="tag t-tag">{tag}</div>
  <div class="view">
    <slot />
    <slot name="overlay" />
  </div>
  <figcaption class="cap t-mono">{caption}</figcaption>
</figure>
<style>
  .plate { position: relative; background: var(--graphite); border: 1px solid var(--rule); border-radius: var(--r-2); padding: clamp(18px, 2.4vw, 32px) clamp(16px, 2.4vw, 32px) 18px; box-shadow: 0 40px 90px -50px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(244, 244, 241, 0.05); }
  .plate i { position: absolute; width: 14px; height: 14px; border: 0 solid var(--rule-2); }
  .plate i:nth-of-type(1) { left: -1px; top: -1px; border-width: 2px 0 0 2px; }
  .plate i:nth-of-type(2) { right: -1px; top: -1px; border-width: 2px 2px 0 0; }
  .plate i:nth-of-type(3) { left: -1px; bottom: -1px; border-width: 0 0 2px 2px; }
  .plate i:nth-of-type(4) { right: -1px; bottom: -1px; border-width: 0 2px 2px 0; }
  .tag { display: inline-block; margin-bottom: 14px; padding: 3px 8px; border: 1px solid currentColor; border-radius: var(--r-1); }
  .cap { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--rule); color: var(--mist-lt); }
  .view { position: relative; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
  @media (max-width: 640px) {
    .plate { padding: 18px 12px 16px; }
    /* cropped on a phone so the marked point stays in view */
    .view :global(.ill) { width: 168%; margin-left: -68%; }
  }
</style>
