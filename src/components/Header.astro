---
import Button from './Button.astro';
import Glyph from './Glyph.astro';
import { PRODUCT, DEMO_URL, site } from '../data/site';
const h = site.header;
---
<div class="progress" aria-hidden="true"></div>
<header class="nav">
  <div class="wrap nav__in">
    <div class="brand">
      <Glyph />
      <div class="brand__txt">
        <a class="brand__name t-wordmark" href="/#top">{PRODUCT}</a>
        <a class="brand__by t-by" href={h.byUrl}>{h.by}</a>
      </div>
    </div>
    <nav aria-label={h.navLabel} class="nav__links">
      {h.links.map((l) => <a href={`/#${l.id}`}>{l.label}</a>)}
    </nav>
    <span class="nav__cta"><Button href={DEMO_URL} size="sm">{h.demo}</Button></span>
    <span class="nav__cta-icon"><Button href={DEMO_URL} size="sm" label={h.demo} /></span>
  </div>
</header>
<style>
  .progress { position: fixed; left: 0; right: 0; top: 0; height: 2px; background: var(--amber); transform-origin: 0 50%; transform: scaleX(0); z-index: 51; pointer-events: none; }
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(13, 15, 18, 0.82); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-bottom: 1px solid transparent; }
  .nav.is-stuck { border-bottom-color: var(--rule); }
  .nav__in { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: var(--nav); }
  /* the glyph spans both text lines; 13px = 1 E at 40px, the gap the Global Storm lockup uses */
  .brand { display: flex; align-items: center; gap: 13px; }
  .brand :global(.gsmark) { font-size: 40px; }
  .brand__txt { display: flex; flex-direction: column; gap: 2px; }
  /* The two brand links are stacked inside the header height, so each box is 32px (28px on a phone):
     above the 24px minimum and not overlapping. A 44px box for both would need a 90px header. */
  .brand__name { display: inline-flex; align-items: center; min-height: var(--brand-hit); text-decoration: none; }
  .brand__by { align-self: flex-start; display: inline-flex; align-items: center; min-height: var(--brand-hit); text-decoration: underline; text-underline-offset: 3px; }
  .nav__links { display: flex; gap: 6px; }
  .nav__links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; color: var(--mist-lt); text-decoration: none; border-bottom: 2px solid transparent; }
  .nav__links a:hover { color: var(--paper); }
  .nav__links a[aria-current='location'] { color: var(--paper); border-bottom-color: var(--amber); }
  .nav__cta-icon { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .nav { transition: border-color 0.25s; }
    .nav__links a { transition: color 0.2s, border-color 0.2s; }
  }
  @media (max-width: 900px) { .nav__links { display: none; } }
  @media (max-width: 640px) {
    .nav__in { gap: 12px; }
    .brand__txt { white-space: nowrap; }
    .brand__by { letter-spacing: 0; }
    .brand :global(.gsmark) { font-size: 36px; }
    /* the approved label, smaller, no arrow; the arrow-only button is kept for the narrowest phones */
    .nav__cta :global(.btn) { padding: 0 10px; font-size: 0.8125rem; white-space: nowrap; }
    .nav__cta :global(.arr) { display: none; }
    .nav__cta-icon { display: none; }
  }
  /* the label needs 171px next to the brand: it fits from 390px wide */
  @media (max-width: 389px) {
    .nav__cta { display: none; }
    .nav__cta-icon { display: inline-flex; }
  }
</style>
