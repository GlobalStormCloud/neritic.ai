---
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- empty icon: no request until a favicon file exists -->
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/saira-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip t-btn t-btn--sm" href="#main">{site.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--ink); color: var(--paper); font: 400 var(--fs-body)/1.55 var(--f-body); -webkit-font-smoothing: antialiased; }
  h1, h2, h3, p, figure, dl, dd, ul { margin: 0; padding: 0; }
  ul { list-style: none; }
  a { color: inherit; }
  p, li { text-wrap: pretty; }
  a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .wrap { width: 100%; max-width: calc(var(--max) + 2 * var(--gut)); margin-inline: auto; padding-inline: var(--gut); }
  .skip { position: absolute; left: var(--gut); top: 8px; z-index: 10; padding: 12px 16px; background: var(--amber); border-radius: var(--r-1); text-decoration: none; transform: translateY(-200%); }
  .skip:focus-visible { transform: none; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
